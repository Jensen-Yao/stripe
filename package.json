{
  "name": "stripe",
  "version": "0.1.0",
  "private": true,
  "description": "Windows satellite stripe planning and TLE orbit visualization tool.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.json && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "satellite.js": "^7.0.1",
    "topojson-client": "^3.1.0",
    "vite": "^7.2.7",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  }
}
