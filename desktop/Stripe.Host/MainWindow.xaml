<Window x:Class="Stripe.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="卫星条带规划工具"
        Width="1540" Height="960" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#EEF1F2"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" FontFamily="Microsoft YaHei UI" FontSize="12">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="新建项目(_N)" InputGestureText="Ctrl+N" Click="NewProject_Click" />
        <MenuItem Header="打开项目(_O)" InputGestureText="Ctrl+O" Click="OpenProject_Click" />
        <Separator />
        <MenuItem Header="保存项目(_S)" InputGestureText="Ctrl+S" Click="SaveProject_Click" />
        <MenuItem Header="项目另存为(_A)" InputGestureText="Ctrl+Shift+S" Click="SaveAsProject_Click" />
        <Separator />
        <MenuItem Header="退出(_X)" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="编辑(_E)">
        <MenuItem Header="撤销(_U)" InputGestureText="Ctrl+Z" Click="Undo_Click" />
        <MenuItem Header="重做(_R)" InputGestureText="Ctrl+Shift+Z" Click="Redo_Click" />
        <Separator />
        <MenuItem Header="剪切(_T)" InputGestureText="Ctrl+X" Click="Cut_Click" />
        <MenuItem Header="复制(_C)" InputGestureText="Ctrl+C" Click="Copy_Click" />
        <MenuItem Header="粘贴(_P)" InputGestureText="Ctrl+V" Click="Paste_Click" />
        <Separator />
        <MenuItem Header="删除所选对象(_D)" InputGestureText="Delete" Click="Delete_Click" />
      </MenuItem>
      <MenuItem Header="视图(_V)">
        <MenuItem Header="二维地图(_2)" Click="View2D_Click" />
        <MenuItem Header="三维地球(_3)" Click="View3D_Click" />
        <Separator />
        <MenuItem Header="重新加载(_R)" InputGestureText="Ctrl+R" Click="Reload_Click" />
        <MenuItem Header="开发者工具(_D)" InputGestureText="F12" Click="DevTools_Click" />
        <Separator />
        <MenuItem Header="全屏(_F)" InputGestureText="F11" Click="Fullscreen_Click" />
      </MenuItem>
      <MenuItem Header="窗口(_W)">
        <MenuItem Header="最小化(_N)" Click="Minimize_Click" />
        <MenuItem Header="关闭(_C)" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于卫星条带规划工具(_A)" Click="About_Click" />
      </MenuItem>
    </Menu>
    <Grid>
      <wv2:WebView2 x:Name="Browser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DefaultBackgroundColor="#EEF1F2" />
      <Border x:Name="LoadingPanel" Background="#EEF1F2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="卫星条带规划工具" FontFamily="Microsoft YaHei UI" FontSize="22" FontWeight="SemiBold" Foreground="#194D5C" HorizontalAlignment="Center" />
          <TextBlock Text="正在启动轻量规划内核..." Margin="0,10,0,0" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#64767B" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
